PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173,https://your-site.netlify.app
MONGODB_URI=mongodb://127.0.0.1:27017
CONTROL_DB_NAME=ugs_control
TENANT_DB_PREFIX=ugs_tenant_
# Generate once with crypto.randomBytes(32).toString('hex'); keep privately backed up.
# Never send this key to the frontend or change it without re-encrypting credentials.
TENANT_CREDENTIAL_KEY=
CUSTOMER_DB_MAX_CONNECTIONS=100
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
EMAIL_FROM=UG SaaS <no-reply@yourdomain.com>
RESEND_API_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
UG_SAAS_LEGAL_NAME=UG SaaS
UG_SAAS_BILLING_ADDRESS=
UG_SAAS_GSTIN=
UG_SAAS_STATE_CODE=33
UG_SAAS_SAC=
UG_SAAS_PHONE=
AUTOMATION_ENABLED=false
# Enable only after staging payment/email verification. Worker runs every 60s.
# TEST_MONGODB_URI=transaction-capable-disposable-staging-cluster
# TEST_CUSTOMER_MONGODB_URI=second-disposable-Atlas-cluster-SRV-URI
